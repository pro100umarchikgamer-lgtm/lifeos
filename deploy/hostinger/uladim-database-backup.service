[Unit]
Description=ULADIM encrypted PostgreSQL backup
Requires=docker.service
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/libexec/uladim/backup-database.sh
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/uladim /var/log/uladim /run/lock
