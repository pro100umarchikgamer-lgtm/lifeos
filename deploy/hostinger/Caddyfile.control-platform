# Candidate only: activate after migration015 + browser-admission acceptance.
# No registration policy, DNS, database volume or secret change.
{$ULADIM_CONTROL_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
        -Server
    }
    @private path /metrics /health/*
    handle @private {
        respond 404
    }
    handle {
        request_body {
            max_size 2MB
        }
        reverse_proxy api:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
