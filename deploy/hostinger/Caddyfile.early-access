# Public application intake only. General account registration remains closed.
{$ULADIM_CONTROL_DOMAIN}, {$LIFEOS_DOMAIN} {
    header {
        X-Content-Type-Options nosniff
        Cache-Control no-store
        -Server
    }
    @private path /metrics /health/*
    handle @private {
        respond 404
    }
    handle {
        header Retry-After 3600
        respond "ULADIM: closed testing is being prepared." 503
    }
}
{$ULADIM_SITE_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    @private path /metrics /health/* /control/*
    handle @private {
        respond 404
    }
    handle {
        request_body {
            max_size 2MB
        }
        reverse_proxy api:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
}
