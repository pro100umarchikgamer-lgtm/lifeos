# Copy to .env on the server; chmod 600. Generate strong values, never commit this file.
LIFEOS_DOMAIN=api.getuladim.space
ULADIM_SITE_DOMAIN=getuladim.space
ULADIM_CONTROL_DOMAIN=control.getuladim.space
ACME_EMAIL=operator@your-domain.example
POSTGRES_DB=lifeos
APP_DB_USER=lifeos
APP_DB_PASSWORD=
DB_ADMIN_PASSWORD=
EMAIL_QUEUE_KEY=
RATE_LIMIT_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=ULADIM <hello@your-domain.example>
DB_POOL_SIZE=4
# Closed testing: exact, comma-separated tester addresses; empty refuses all new accounts.
REGISTRATION_MODE=closed
REGISTRATION_ALLOWLIST=
# Same-project Android OAuth client IDs; exact comma-separated public identifiers.
# Keep the existing package/certificate. Empty trusts no additional Android azp.
GOOGLE_OAUTH_ANDROID_CLIENT_IDS=
# Container directory with only the accepted release.json and ULADIM.apk, mounted read-only.
# Empty disables same-origin APK serving. The reviewed runtime override adds the mount.
NATIVE_DOWNLOAD_DIR=
# Separate record-only root ACK journal. Once provisioned, required stays true on restore.
# Mount the journal read-only and the separate root Unix socket into API and worker.
RECORD_ERASURE_LEDGER=
RECORD_ERASURE_ACK_SOCKET=
RECORD_ERASURE_REQUIRED=false
