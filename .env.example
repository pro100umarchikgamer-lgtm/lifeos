# Copy to .env on the server; chmod 600. Generate strong values, never commit this file.
LIFEOS_DOMAIN=api.getuladim.space
ULADIM_SITE_DOMAIN=getuladim.space
ULADIM_CONTROL_DOMAIN=control.getuladim.space
ACME_EMAIL=operator@your-domain.example
POSTGRES_DB=lifeos
APP_DB_USER=lifeos
APP_DB_PASSWORD=
DB_ADMIN_PASSWORD=
EMAIL_QUEUE_KEY=
RATE_LIMIT_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=ULADIM <hello@your-domain.example>
DB_POOL_SIZE=4
# Closed testing: exact, comma-separated tester addresses; empty refuses all new accounts.
REGISTRATION_MODE=closed
REGISTRATION_ALLOWLIST=
